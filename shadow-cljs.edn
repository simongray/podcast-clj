{:deps   {:aliases [:cljs]}

 :builds {;; clojure -M:cljs compile test
          ;; Runs every -test namespace under Node, where the test-setup
          ;; namespace supplies a DOMParser from @xmldom/xmldom.
          :test         {:target    :node-test
                         :output-to "target/node-tests.js"
                         :ns-regexp "-test$"
                         :autorun   true}

          ;; clojure -M:cljs compile browser-test, then serve target/browser-test
          ;; and open it: the same tests against the browser's own DOMParser.
          :browser-test {:target    :browser-test
                         :test-dir  "target/browser-test"
                         :ns-regexp "-test$"}}}
