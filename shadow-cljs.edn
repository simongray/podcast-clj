{:deps   {:aliases [:cljs]}
 :builds {;; clojure -M:cljs compile test          (the suite under Node)
          :test         {:target    :node-test
                         :output-to "target/node-tests.js"
                         :ns-regexp "-test$"
                         :autorun   true}
          ;; clojure -M:cljs compile browser-test  (the suite for a browser;
          ;; the -node-test namespaces need Node's modules and stay out)
          :browser-test {:target    :browser-test
                         :test-dir  "target/browser-test"
                         :ns-regexp "(?<!-node)-test$"}
          ;; clojure -M:cljs compile player        (the inspector's player, served at /js/shared.js
          ;; and /js/player.js, and its web worker at /js/worker.js)
          :player       {:target     :browser
                         :output-dir "target/web/public/js"
                         :asset-path "/js"
                         :modules    {:shared {:entries []}
                                      :player {:init-fn    inspector.player/init
                                               :depends-on #{:shared}}
                                      :worker {:init-fn    inspector.worker/init
                                               :depends-on #{:shared}
                                               :web-worker true}}}}}
