{:paths ["src" "resources"]

 ;; The library proper depends on Clojure alone, plus data.json for the JVM
 ;; side of the JSON adapter (chapters, transcripts, Podcast Index). The
 ;; Clojure version here is the floor the library needs, and the one its pom
 ;; states; development and the tests run on the current release through
 ;; :override-deps, and the :test-floor alias on the floor itself.
 ;;
 ;; org.jsoup/jsoup is optional: with it on the classpath, feeds that are not
 ;; well-formed even after repair are parsed leniently instead of rejected.
 :deps  {org.clojure/clojure   {:mvn/version "1.11.4"}
         org.clojure/data.json {:mvn/version "2.5.2"}}

 :aliases
 {;; The bundled reference web app: a feed inspector built only on the public
  ;; API of the library. Pedestal serves it, Replicant renders the HTML.
  :web   {:extra-paths   ["web"]
          :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
          :extra-deps    {io.pedestal/pedestal.service {:mvn/version "0.8.2-beta-11"}
                          io.pedestal/pedestal.jetty   {:mvn/version "0.8.2-beta-11"}
                          no.cjohansen/replicant       {:mvn/version "2026.07.1"}
                          org.jsoup/jsoup              {:mvn/version "1.23.2"}}
          :main-opts     ["-m" "dk.simongray.podcast.web.service"]
          :exec-fn       dk.simongray.podcast.web.service/start!}

  ;; REPL-driven development: everything on the classpath, including the
  ;; corpus tooling in dev/ and the reference web app, plus criterium for
  ;; benchmarks and the clojure-goes-fast profiler and decompiler.
  :dev   {:extra-paths   ["dev" "test" "test/resources" "web"]
          :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
          :extra-deps    {io.pedestal/pedestal.service {:mvn/version "0.8.2-beta-11"}
                          io.pedestal/pedestal.jetty   {:mvn/version "0.8.2-beta-11"}
                          no.cjohansen/replicant       {:mvn/version "2026.07.1"}
                          org.jsoup/jsoup              {:mvn/version "1.23.2"}
                          metosin/malli                {:mvn/version "0.20.2"}
                          org.clojure/test.check       {:mvn/version "1.1.3"}
                          criterium/criterium          {:mvn/version "0.4.6"}
                          com.clojure-goes-fast/clj-async-profiler  {:mvn/version "1.8.0"}
                          com.clojure-goes-fast/clj-java-decompiler {:mvn/version "0.3.7"}}}

  ;; clojure -X:test; dev/ is on the path for the test that keeps the
  ;; generated documents in doc/ current
  :test  {:extra-paths   ["dev" "test" "test/resources" "web"]
          :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
          :extra-deps    {io.github.cognitect-labs/test-runner
                          {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                          io.pedestal/pedestal.service {:mvn/version "0.8.2-beta-11"}
                          io.pedestal/pedestal.jetty   {:mvn/version "0.8.2-beta-11"}
                          no.cjohansen/replicant       {:mvn/version "2026.07.1"}
                          org.jsoup/jsoup              {:mvn/version "1.23.2"}
                          metosin/malli                {:mvn/version "0.20.2"}
                          org.clojure/test.check       {:mvn/version "1.1.3"}}
          :main-opts     ["-m" "cognitect.test-runner"]
          :exec-fn       cognitect.test-runner.api/test}

  ;; clojure -X:test-floor: the library's own tests on the Clojure the
  ;; library declares, on a JVM as old as Java 11. The web app and the
  ;; generated documents stay out, since Pedestal needs a newer Java.
  :test-floor {:extra-paths ["test" "test/resources"]
               :extra-deps  {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             org.jsoup/jsoup        {:mvn/version "1.23.2"}
                             metosin/malli          {:mvn/version "0.20.2"}
                             org.clojure/test.check {:mvn/version "1.1.3"}}
               :exec-fn     cognitect.test-runner.api/test
               :exec-args   {:patterns ["dk\\.simongray\\.podcast\\.(?!web\\.)(?!reference-).*-test"]}}

  ;; clojure -M:cljs compile test          (the suite under Node)
  ;; clojure -M:cljs compile browser-test  (the suite for a browser)
  ;; clojure -M:cljs compile player        (the inspector's browser player)
  :cljs  {:extra-paths   ["test" "test/resources" "web"]
          :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
          :extra-deps    {thheller/shadow-cljs     {:mvn/version "3.5.3"}
                          no.cjohansen/replicant {:mvn/version "2026.07.1"}}
          :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  ;; clojure -T:build jar | install | deploy  (see build.clj)
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       slipset/deps-deploy            {:mvn/version "0.2.5"}}
          :ns-default build}

  ;; clojure -M:dev:nrepl
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
          ;; lets nrepl interrupt runaway evaluations
          :jvm-opts   ["-Djdk.attach.allowAttachSelf"]
          :main-opts  ["-m" "nrepl.cmdline" "--port" "7888"]}}}
