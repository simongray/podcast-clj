{:paths ["src"]

 ;; The library proper depends on Clojure alone, plus data.json for the JVM
 ;; side of the JSON adapter (chapters, transcripts, Podcast Index),
 ;; wary-fetch for HTTP, qname-hiccup for the XML of feeds and lists,
 ;; html-pieces for the HTML in show notes and comments, drop-in-search for
 ;; full-text search, mind-meld for the CRDT of the listener's profile,
 ;; like-minded for syncing it and for the stores, websub-clj for WebSub,
 ;; whatwg-mime for media types, langtag-clj for language tags,
 ;; webcrypto-clj for bytes, their encodings, hashes and HMACs, id3-clj for
 ;; the ID3v2 tags of media files, webvtt-clj for WebVTT transcripts, and
 ;; ical-clj for the recurrence rules of podcast:updateFrequency.
 ;; The Clojure version here is the floor the library needs, and the one its
 ;; pom states; development and the tests run on the current release through
 ;; :override-deps, and the :test-floor alias on the floor itself.
 ;;
 ;; org.jsoup/jsoup is optional: with it on the classpath, feeds that are not
 ;; well-formed even after repair are parsed leniently instead of rejected.
 :deps  {org.clojure/clojure      {:mvn/version "1.11.4"}
         org.clojure/data.json    {:mvn/version "2.5.2"}
         dk.simongray/wary-fetch     {:mvn/version "0.15.1"}
         dk.simongray/qname-hiccup   {:mvn/version "0.6.0"}
         dk.simongray/html-pieces    {:mvn/version "0.7.0"}
         dk.simongray/drop-in-search {:mvn/version "0.3.0"}
         dk.simongray/websub-clj     {:mvn/version "0.7.0"}
         dk.simongray/mind-meld      {:mvn/version "0.4.0"}
         dk.simongray/like-minded    {:mvn/version "0.4.2"}
         dk.simongray/whatwg-mime    {:mvn/version "0.2.2"}
         dk.simongray/langtag-clj    {:mvn/version "0.2.0"}
         dk.simongray/webcrypto-clj  {:mvn/version "0.1.3"}
         dk.simongray/id3-clj        {:mvn/version "0.1.1"}
         dk.simongray/webvtt-clj     {:mvn/version "0.1.0"}
         dk.simongray/ical-clj       {:mvn/version "0.2.0"}}

 :aliases
 {;; The bundled reference web app: a feed inspector built only on the public
  ;; API of the library. Pedestal serves it, Replicant renders the HTML.
  :web   {:extra-paths   ["web"]
          :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
          :extra-deps    {io.pedestal/pedestal.service {:mvn/version "0.8.2-beta-11"}
                          io.pedestal/pedestal.jetty   {:mvn/version "0.8.2-beta-11"}
                          no.cjohansen/replicant       {:mvn/version "2026.07.1"}
                          org.jsoup/jsoup              {:mvn/version "1.23.2"}}
          :main-opts     ["-m" "inspector.service"]
          :exec-fn       inspector.service/start!}

  ;; The self-hosted podcast server: the parts of a podcast app that must
  ;; run on a server, for a client that runs in the browser. It reads the
  ;; feeds that aren't well-formed XML with jsoup, signs its requests for
  ;; ActivityPub documents with httpsig-clj, and logs to stderr through
  ;; slf4j-simple.
  :server {:extra-paths   ["server"]
           :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
           :extra-deps    {io.pedestal/pedestal.service {:mvn/version "0.8.2-beta-11"}
                           io.pedestal/pedestal.jetty   {:mvn/version "0.8.2-beta-11"}
                           dk.simongray/httpsig-clj     {:mvn/version "0.1.1"}
                           org.jsoup/jsoup              {:mvn/version "1.23.2"}
                           org.slf4j/slf4j-simple       {:mvn/version "2.0.18"}}
           :main-opts     ["-m" "podcast-server.service"]}

  ;; REPL-driven development: everything on the classpath, including the
  ;; corpus tooling in dev/, the reference web app and the server, plus
  ;; criterium for benchmarks and the clojure-goes-fast profiler and
  ;; decompiler.
  :dev   {:extra-paths   ["dev" "test" "test/resources" "web" "server"]
          :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
          :extra-deps    {io.pedestal/pedestal.service {:mvn/version "0.8.2-beta-11"}
                          io.pedestal/pedestal.jetty   {:mvn/version "0.8.2-beta-11"}
                          dk.simongray/httpsig-clj     {:mvn/version "0.1.1"}
                          no.cjohansen/replicant       {:mvn/version "2026.07.1"}
                          org.jsoup/jsoup              {:mvn/version "1.23.2"}
                          metosin/malli                {:mvn/version "0.20.2"}
                          org.clojure/test.check       {:mvn/version "1.1.3"}
                          criterium/criterium          {:mvn/version "0.4.6"}
                          com.clojure-goes-fast/clj-async-profiler  {:mvn/version "1.8.0"}
                          com.clojure-goes-fast/clj-java-decompiler {:mvn/version "0.3.7"}}}

  ;; clojure -X:test; dev/ is on the path for the test that keeps the
  ;; generated documents in doc/ current
  :test  {:extra-paths   ["dev" "test" "test/resources" "web" "server"]
          :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
          :extra-deps    {io.github.cognitect-labs/test-runner
                          {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                          io.pedestal/pedestal.service {:mvn/version "0.8.2-beta-11"}
                          io.pedestal/pedestal.jetty   {:mvn/version "0.8.2-beta-11"}
                          dk.simongray/httpsig-clj     {:mvn/version "0.1.1"}
                          no.cjohansen/replicant       {:mvn/version "2026.07.1"}
                          org.jsoup/jsoup              {:mvn/version "1.23.2"}
                          metosin/malli                {:mvn/version "0.20.2"}
                          org.clojure/test.check       {:mvn/version "1.1.3"}}
          :main-opts     ["-m" "cognitect.test-runner"]
          :exec-fn       cognitect.test-runner.api/test}

  ;; clojure -X:test-floor: the library's own tests on the Clojure the
  ;; library declares, on a JVM as old as Java 11. The inspector, whose
  ;; Pedestal needs a newer Java, and the generated documents stay out.
  :test-floor {:extra-paths ["test" "test/resources"]
               :extra-deps  {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             org.jsoup/jsoup        {:mvn/version "1.23.2"}
                             metosin/malli          {:mvn/version "0.20.2"}
                             org.clojure/test.check {:mvn/version "1.1.3"}}
               :exec-fn     cognitect.test-runner.api/test
               :exec-args   {:patterns ["dk\\.simongray\\.podcast\\.(?!reference-).*-test"]}}

  ;; clojure -M:cljs compile test          (the suite under Node)
  ;; clojure -M:cljs compile browser-test  (the suite for a browser)
  ;; clojure -M:cljs compile player        (the inspector's browser player)
  :cljs  {:extra-paths   ["test" "test/resources" "web"]
          :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
          :extra-deps    {thheller/shadow-cljs     {:mvn/version "3.5.3"}
                          no.cjohansen/replicant {:mvn/version "2026.07.1"}
                          dk.simongray/play-nice {:mvn/version "0.1.0"}}
          :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  ;; clojure -T:build jar | install | deploy  (see build.clj). The
  ;; tools.deps of tools.build 0.10.14 shares no resolver session across
  ;; threads, which 0.31.1638 fixed, and a CI build of the server failed
  ;; on a HashMap that two threads changed at once.
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       org.clojure/tools.deps        {:mvn/version "0.31.1646"}
                       slipset/deps-deploy            {:mvn/version "0.2.5"}}
          :ns-default build}

  ;; wary-fetch, qname-hiccup, html-pieces, drop-in-search, mind-meld,
  ;; like-minded, websub-clj, whatwg-mime, langtag-clj, webcrypto-clj,
  ;; id3-clj, webvtt-clj, ical-clj and httpsig-clj from checkouts beside
  ;; this one, to change them and podcast-clj at once, e.g.
  ;; clojure -M:dev:local:nrepl
  :local {:override-deps
          {dk.simongray/wary-fetch     {:local/root "../wary-fetch"}
           dk.simongray/qname-hiccup   {:local/root "../qname-hiccup"}
           dk.simongray/html-pieces    {:local/root "../html-pieces"}
           dk.simongray/drop-in-search {:local/root "../drop-in-search"}
           dk.simongray/mind-meld      {:local/root "../mind-meld"}
           dk.simongray/like-minded    {:local/root "../like-minded"}
           dk.simongray/websub-clj     {:local/root "../websub-clj"}
           dk.simongray/whatwg-mime    {:local/root "../whatwg-mime"}
           dk.simongray/langtag-clj    {:local/root "../langtag-clj"}
           dk.simongray/webcrypto-clj  {:local/root "../webcrypto-clj"}
           dk.simongray/id3-clj        {:local/root "../id3-clj"}
           dk.simongray/webvtt-clj     {:local/root "../webvtt-clj"}
           dk.simongray/ical-clj       {:local/root "../ical-clj"}
           dk.simongray/httpsig-clj    {:local/root "../httpsig-clj"}}}

  ;; clojure -M:dev:nrepl
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
          ;; lets nrepl interrupt runaway evaluations
          :jvm-opts   ["-Djdk.attach.allowAttachSelf"]
          :main-opts  ["-m" "nrepl.cmdline" "--port" "7888"]}}}
